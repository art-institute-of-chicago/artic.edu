{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "aic/website",
    "description": "Art Institute of Chicago website – artic.edu",
    "keywords": [
        "website",
        "museum",
        "musetech",
        "art institute of chicago"
    ],
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/art-institute-of-chicago/data-hub-foundation.git"
        },
        {
            "type": "package",
            "package": {
                "type": "metapackage",
                "name": "vendor/package-patches",
                "version": "1.14.0",
                "require": {
                    "netresearch/composer-patches-plugin": "^1.3.1"
                },
                "extra": {
                    "patches": {
                        "area17/twill": [
                            {
                                "title": "WEB-2301: Get repository model of API models",
                                "url": "patches/WEB-2301---get-repository-of-API-models.diff"
                            },
                            {
                                "title": "WEB-3051: Fix DatePicker.vue from using timezones",
                                "url": "patches/WEB-3051---fix-date-picker-from-using-timezones.diff"
                            },
                            {
                                "title": "WEB-3084: Fix Preview Changes",
                                "url": "patches/WEB-3084---remove-eager-loading-related-items-on-hydrate.diff"
                            },
                            {
                                "title": "WEB-3330: Pass params to Twill browser",
                                "url": "patches/WEB-3330---pass-params-to-twill-browser.diff"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "require": {
        "php": "^8.5",
        "aic/data-hub-foundation": "^6.0",
        "area17/twill": "^3.0",
        "chillerlan/php-qrcode": "^6.0",
        "eluceo/ical": "2.0",
        "erusev/parsedown": "^1.7",
        "google/apiclient": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/httpauth": "^4.0",
        "kalnoy/nestedset": "^7.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "league/csv": "^9.0",
        "michelf/php-smartypants": "^1.8",
        "pgvector/pgvector": "^0.2.2",
        "ramsey/uuid": "^4.0",
        "rlanvin/php-rrule": "^2.0",
        "sendgrid/sendgrid": "^8.1",
        "sentry/sentry-laravel": "^4.18",
        "spatie/calendar-links": "^1.0",
        "spatie/laravel-feed": "^4.0",
        "spatie/laravel-sitemap": "^7.0",
        "vendor/package-patches": "^1.0",
        "yeslogic/prince-php-wrapper": "^1.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.0",
        "itsgoingd/clockwork": "^5.0",
        "laravel/sail": "^1.44",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --parallel --stop-on-failure"
        ],
        "pre-autoload-dump": [
            "Google\\Task\\Composer::cleanup"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi  --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "@putenv COMPOSER=vendor/aic/data-hub-foundation/composer.json",
            "@composer lint"
        ],
        "format": [
            "@putenv COMPOSER=vendor/aic/data-hub-foundation/composer.json",
            "@composer format"
        ],
        "analyze": [
            "phpstan analyze ."
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "google/apiclient-services": [
            "YouTube"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "netresearch/composer-patches-plugin": true,
            "php-http/discovery": true
        }
    }
}
